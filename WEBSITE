<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Suyeon | Portfolio</title>
<style>
    :root {
        --radius-lg: 20px;
        --radius-md: 16px;
        --shadow-sm: 0 4px 12px rgba(0,0,0,0.1);
        --shadow-md: 0 6px 18px rgba(0,0,0,0.12);
        --accent: #4f46e5;
        --accent-dark: #3730a3;
        --text-main: #222;
        --text-muted: #666;
        --bg: #f4f4f9;
    }

    * { box-sizing: border-box; }

    body {
        font-family: Arial, Helvetica, sans-serif;
        margin: 0;
        background-color: var(--bg);
        color: var(--text-main);
    }

    /* ---------- Top Nav Menu ---------- */
    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 32px;
        background: #fff;
        box-shadow: var(--shadow-sm);
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .nav-logo {
        font-weight: bold;
        font-size: 18px;
        color: var(--text-main);
        text-decoration: none;
        letter-spacing: 0.5px;
    }

    .nav-links {
        display: flex;
        gap: 28px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav-links a {
        text-decoration: none;
        color: var(--text-main);
        font-size: 14px;
        font-weight: 600;
        padding-bottom: 4px;
        border-bottom: 2px solid transparent;
        transition: border-color 0.2s ease, color 0.2s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }

    .nav-toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
    }

    .nav-toggle span {
        width: 24px;
        height: 2px;
        background: var(--text-main);
    }

    @media (max-width: 700px) {
        .nav-toggle { display: flex; }

        .nav-links {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #fff;
            flex-direction: column;
            gap: 0;
            box-shadow: var(--shadow-sm);
        }

        .nav-links.open { display: flex; }

        .nav-links a {
            padding: 14px 24px;
            border-bottom: 1px solid #eee;
        }
    }

    /* ---------- Page Layout ---------- */
    .page {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 40px;
        padding: 40px;
        flex-wrap: wrap;
    }

    /* ---------- Profile Sidebar ---------- */
    .profile-sidebar {
        width: 260px;
        background: #fff;
        padding: 24px;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
    }

    .profile-name {
        font-size: 22px;
        font-weight: bold;
        margin: 0 0 4px 0;
    }

    .profile-handle {
        font-size: 14px;
        color: var(--text-muted);
        margin-bottom: 12px;
    }

    .profile-bio {
        font-size: 14px;
        color: #444;
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .social-links {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .social-links a {
        text-decoration: none;
        color: var(--accent);
        font-size: 14px;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: color 0.2s ease;
    }

    .social-links a:hover {
        color: var(--accent-dark);
    }

    /* ---------- Artwork Gallery Card ---------- */
    .card-container {
        width: 440px;
        max-width: 100%;
        background: #fff;
        padding: 24px;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        text-align: center;
    }

    .image-box {
        position: relative;
        width: 100%;
        height: 560px;
        border-radius: var(--radius-md);
        overflow: hidden;
        cursor: pointer;
        touch-action: pan-y; /* allow horizontal swipe to be captured by JS */
        user-select: none;
    }

    .image-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
        pointer-events: none; /* avoid ghost-dragging the image on swipe */
    }

    .image-box:hover img {
        transform: scale(1.03);
    }

    .nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(0, 0, 0, 0.5);
        color: #fff;
        border: none;
        padding: 12px 16px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 18px;
        user-select: none;
    }

    .nav-btn:hover {
        background: rgba(0, 0, 0, 0.8);
    }

    .prev-btn { left: 12px; }
    .next-btn { right: 12px; }

    .dots {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 14px;
    }

    .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #d8d8e6;
        cursor: pointer;
        border: none;
        padding: 0;
    }

    .dot.active {
        background: var(--accent);
    }

    .description-panel {
        display: none;
        margin-top: 16px;
        padding: 14px;
        background: #eef2ff;
        border-radius: 10px;
        color: #333;
        font-size: 14px;
        text-align: left;
    }

    .click-hint {
        font-size: 12px;
        color: #777;
        margin-top: 12px;
        margin-bottom: 0;
    }
</style>
</head>
<body>

<!-- ===== Top Menu ===== -->
<nav class="navbar">
    <a href="#" class="nav-logo">SUYEON.ARTS</a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
    </button>
    <ul class="nav-links" id="navLinks">
        <li><a href="#" class="active">Home</a></li>
        <li><a href="#gallery">Gallery</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
    </ul>
</nav>

<div class="page">

    <!-- LEFT SIDE: Profile Section -->
    <div class="profile-sidebar" id="about">
        <h2 class="profile-name">Suyeon</h2>
        <div class="profile-handle">@SUYEON.ARTS</div>

        <p class="profile-bio">
            Digital artist &amp; illustrator exploring character design, atmosphere, and vibrant color studies.
        </p>

        <hr style="border: 0; border-top: 1px solid #eee; margin-bottom: 16px;">

        <div class="social-links" id="contact">
            <a href="https://instagram.com" target="_blank" rel="noopener">📸 Instagram</a>
            <a href="https://twitter.com" target="_blank" rel="noopener">🐦 Twitter / X</a>
            <a href="https://artstation.com" target="_blank" rel="noopener">🎨 ArtStation</a>
            <a href="mailto:your-email@example.com">✉️ Contact Email</a>
        </div>
    </div>

    <!-- RIGHT SIDE: Artwork Gallery -->
    <div class="card-container" id="gallery">
        <div class="image-box" id="imageBox">
            <img id="artwork" src="" alt="Artwork">
            <button class="nav-btn prev-btn" id="prevBtn" aria-label="Previous artwork">&#10094;</button>
            <button class="nav-btn next-btn" id="nextBtn" aria-label="Next artwork">&#10095;</button>
        </div>

        <div class="dots" id="dots"></div>

        <p class="click-hint">(Click image to show/hide details &middot; swipe to browse)</p>

        <div id="descBox" class="description-panel">
            <strong id="artTitle"></strong>
            <p id="artDetails" style="margin: 6px 0 0 0;"></p>
        </div>
    </div>

</div>

<script>
    // ---------- Gallery data (single source of truth) ----------
    const gallery = [
        {
            src: "imagess/BLEu.png",
            title: "BLUE.SKY",
            details: "Digital illustration exploring cool color palettes and atmospheric lighting.",
            alt: "Illustration in cool blue tones with atmospheric lighting"
        },
        {
            src: "imagess/blue2.png",
            title: "EMO BLUE",
            details: "Secondary portrait study focusing on character expressions and blue shades.",
            alt: "Portrait study in blue shades focusing on expression"
        },
        {
            src: "imagess/RED_LILIEES.png",
            title: "RED LILIES",
            details: "Vibrant artwork exploring rich crimson hues and botanical elements.",
            alt: "Vibrant botanical illustration in rich crimson hues"
        }
    ];

    let currentIndex = 0;

    const artImg = document.getElementById("artwork");
    const artTitle = document.getElementById("artTitle");
    const artDetails = document.getElementById("artDetails");
    const imageBox = document.getElementById("imageBox");
    const descBox = document.getElementById("descBox");
    const dotsWrap = document.getElementById("dots");

    // Build dot indicators
    gallery.forEach((_, i) => {
        const dot = document.createElement("button");
        dot.className = "dot";
        dot.setAttribute("aria-label", "Go to artwork " + (i + 1));
        dot.addEventListener("click", (e) => {
            e.stopPropagation();
            currentIndex = i;
            updateGallery();
        });
        dotsWrap.appendChild(dot);
    });

    function updateGallery() {
        const item = gallery[currentIndex];
        artImg.src = item.src;
        artImg.alt = item.alt;
        artTitle.innerText = item.title;
        artDetails.innerText = item.details;

        [...dotsWrap.children].forEach((dot, i) => {
            dot.classList.toggle("active", i === currentIndex);
        });
    }

    function prevImage() {
        currentIndex = (currentIndex - 1 + gallery.length) % gallery.length;
        updateGallery();
    }

    function nextImage() {
        currentIndex = (currentIndex + 1) % gallery.length;
        updateGallery();
    }

    function toggleDescription() {
        descBox.style.display = (descBox.style.display === "block") ? "none" : "block";
    }

    document.getElementById("prevBtn").addEventListener("click", (e) => {
        e.stopPropagation();
        prevImage();
    });

    document.getElementById("nextBtn").addEventListener("click", (e) => {
        e.stopPropagation();
        nextImage();
    });

    imageBox.addEventListener("click", toggleDescription);

    // ---------- Keyboard support ----------
    document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") prevImage();
        if (e.key === "ArrowRight") nextImage();
    });

    // ---------- Touch / trackpad swipe support ----------
    let startX = 0;
    let startY = 0;
    let isSwiping = false;
    const SWIPE_THRESHOLD = 40; // minimum px to count as a swipe

    imageBox.addEventListener("touchstart", (e) => {
        const t = e.changedTouches[0];
        startX = t.clientX;
        startY = t.clientY;
        isSwiping = true;
    }, { passive: true });

    imageBox.addEventListener("touchend", (e) => {
        if (!isSwiping) return;
        isSwiping = false;
        const t = e.changedTouches[0];
        const dx = t.clientX - startX;
        const dy = t.clientY - startY;

        // Only treat as swipe if horizontal movement dominates
        if (Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
            if (dx < 0) nextImage(); else prevImage();
        }
    }, { passive: true });

    // Trackpad / mouse-wheel horizontal swipe (many trackpads fire wheel deltaX)
    let wheelCooldown = false;
    imageBox.addEventListener("wheel", (e) => {
        if (Math.abs(e.deltaX) < Math.abs(e.deltaY)) return; // vertical scroll, ignore
        if (wheelCooldown) return;
        if (Math.abs(e.deltaX) < 20) return;

        wheelCooldown = true;
        if (e.deltaX > 0) nextImage(); else prevImage();
        setTimeout(() => { wheelCooldown = false; }, 400);
    }, { passive: true });

    // ---------- Mobile nav menu toggle ----------
    const navToggle = document.getElementById("navToggle");
    const navLinks = document.getElementById("navLinks");
    navToggle.addEventListener("click", () => {
        navLinks.classList.toggle("open");
    });
    navLinks.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", () => navLinks.classList.remove("open"));
    });

    // ---------- Init ----------
    updateGallery();
</script>

</body>
</html>
